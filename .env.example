# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL of the site (metadata, sitemap, Open Graph, links in emails)
NEXT_PUBLIC_SITE_URL=https://theafterbells.com

# ─── Database ────────────────────────────────────────────────────────────────
# Production: any Postgres. Neon (neon.tech) or Supabase work well with Vercel — use the
# *pooled* connection string. Tables are created automatically on first use.
# Leave empty locally to store data as JSON files in /.data.
DATABASE_URL=
# Optional: where the JSON files live when DATABASE_URL is empty (e.g. a mounted disk on a VPS)
DATA_DIR=

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Checkout is unavailable until configured. Use test keys (rzp_test_…) first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local development only: complete checkout without paying. Never works in production.
ALLOW_DEMO_PAYMENTS=false

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Confirmation, dispatch and cancellation emails. Without it, guests see their number on screen.
RESEND_API_KEY=
EMAIL_FROM="After Bells <concierge@afterbells.com>"
# Receives a copy of every paid reservation
ORDER_NOTIFY_EMAIL=

# ─── Admin (/admin) ──────────────────────────────────────────────────────────
# Admin is disabled while the password is empty. Use a long, unique password.
ADMIN_USER=house
ADMIN_PASSWORD=
